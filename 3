#include <stdio.h>

typedef struct {
    int dia;
    double valor;
} Faturamento;

int main() {
    Faturamento dados[] = {
        {1, 22174.1664}, {2, 24537.6698}, {3, 26139.6134}, {4, 0.0}, {5, 0.0},
        {6, 26742.6612}, {7, 0.0}, {8, 42889.2258}, {9, 46251.174}, {10, 11191.4722},
        {11, 0.0}, {12, 0.0}, {13, 3847.4823}, {14, 373.7838}, {15, 2659.7563},
        {16, 48924.2448}, {17, 18419.2614}, {18, 0.0}, {19, 0.0}, {20, 35240.1826},
        {21, 43829.1667}, {22, 18235.6852}, {23, 4355.0662}, {24, 13327.1025},
        {25, 0.0}, {26, 0.0}, {27, 25681.8318}, {28, 1718.1221}, {29, 13220.495},
        {30, 8414.61}
    };
    int n = sizeof(dados) / sizeof(dados[0]);
    double min = 1e9, max = -1e9, soma = 0.0;
    int count = 0, dias_acima_media = 0;

    for (int i = 0; i < n; i++) {
        if (dados[i].valor > 0) {
            if (dados[i].valor < min) min = dados[i].valor;
            if (dados[i].valor > max) max = dados[i].valor;
            soma += dados[i].valor;
            count++;
        }
    }

    double media = soma / count;

    for (int i = 0; i < n; i++) {
        if (dados[i].valor > media) dias_acima_media++;
    }

    printf("Menor valor de faturamento ocorrido em um dia do mês: %.4f\n", min);
    printf("Maior valor de faturamento ocorrido em um dia do mês: %.4f\n", max);
    printf("Número de dias no mês em que o valor de faturamento diário foi superior à média mensal: %d\n", dias_acima_media);

    return 0;
}